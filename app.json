{
  "expo": {
    "name": "Terra Lotus",
    "slug": "terra-lotus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "terralotus",
    "icon": "./assets/logo-vivid.png",
    "splash": {
      "image": "./assets/logo-vivid.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.terralotus.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Terra Lotus needs access to your photo library to upload review photos.",
        "NSCameraUsageDescription": "Terra Lotus needs camera access to take product review photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-vivid.png",
        "backgroundColor": "#FAF7F2"
      },
      "package": "com.terralotus.app",
      "versionCode": 1,
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/logo-vivid.png",
          "color": "#C9A44A",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e1c60d08-c38f-4e67-a499-8bbcc5321029"
      }
    }
  }
}
